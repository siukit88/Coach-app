<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Kit Coach 團隊特訓大數據平台 v40.0</title>
    <style>
        body { margin: 0; padding: 0; background-color: #121212; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #ffffff; }
        .phone-container { width: 100%; max-width: 412px; min-height: 100vh; background: #16161a; margin: 0 auto; padding-bottom: 40px; box-sizing: border-box; }
        
        /* 🎯 頂部專屬粉紅色 Banner */
        .header { background: #ff3366; padding: 20px; text-align: left; }
        .header h1 { margin: 0; font-size: 22px; font-weight: bold; letter-spacing: 0.5px; }
        .header p { margin: 5px 0 0 0; font-size: 13px; color: rgba(255,255,255,0.9); }
        
        .form-container { padding: 20px; }
        .section-title { font-size: 16px; font-weight: bold; margin: 10px 0 20px 0; display: flex; align-items: center; }
        .section-title::before { content: ""; display: inline-block; width: 4px; height: 16px; background: #ff3366; margin-right: 8px; border-radius: 2px; }
        
        /* 🚀 投放區域排版 */
        .upload-row { display: flex; gap: 12px; margin-bottom: 25px; }
        .upload-box { flex: 1; background: #1e1e24; border-radius: 8px; padding: 15px 10px; text-align: center; cursor: pointer; box-sizing: border-box; }
        .upload-box.fit { border: 2px dashed #00f2fe; }
        .upload-box.img { border: 2px dashed #ff3366; }
        .upload-box .icon { font-size: 24px; margin-bottom: 8px; display: block; text-align: center; width: 100%; }
        .upload-box .title { font-size: 14px; font-weight: bold; margin-bottom: 4px; }
        .upload-box.fit .title { color: #00f2fe; }
        .upload-box.img .title { color: #ff3366; }
        .upload-box .desc { font-size: 11px; color: #888888; }
        
        /* 📝 表單輸入框排版 */
        .input-group { margin-bottom: 20px; text-align: left; }
        .input-group label { display: block; font-size: 14px; color: #aaa; margin-bottom: 8px; }
        
        .select-ctrl, .input-ctrl { width: 100%; background: #1e1e24; border: 1px solid #333; border-radius: 6px; padding: 12px; color: #fff; font-size: 15px; box-sizing: border-box; outline: none; transition: border-color 0.2s; }
        .select-ctrl:focus, .input-ctrl:focus { border-color: #ff3366; }
        
        .grid-2 { display: flex; gap: 12px; }
        .grid-2 .input-group { flex: 1; }
        
        /* 體感區塊樣式（保留原本 v36 樣式並增加可選功能） */
        .badge-container { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 5px; }
        .status-badge { display: inline-block; background: rgba(255, 255, 255, 0.05); border: 1px solid #444; color: #aaa; padding: 8px 14px; border-radius: 20px; font-size: 13px; font-weight: bold; cursor: pointer; user-select: none; }
        .status-badge.active { background: rgba(0, 242, 254, 0.1); border: 1px solid #00f2fe; color: #00f2fe; }
        .status-badge.active.danger { background: rgba(255, 51, 102, 0.1); border: 1px solid #ff3366; color: #ff3366; }
        
        /* ⬅️ 返回主頁按鈕 */
        .nav-zone { text-align: center; margin-top: 30px; }
        .nav-link { display: inline-block; color: #ff3366; font-size: 15px; text-decoration: none; font-weight: bold; padding: 10px; }
        
        .hidden-file { display: none !important; }
    </style>
</head>
<body>

<div class="phone-container">
    <div class="header">
        <h1>Kit Coach 團隊特訓大數據平台</h1>
        <p>慢慢跑團 遠程智慧特訓 platform v40.0</p>
    </div>

    <div class="form-container">
        <form id="trainingForm">
            <div class="section-title">📝 步驟一：學員功課手動回報</div>
            
            <div class="upload-row">
                <div class="upload-box fit" id="fitTrigger">
                    <span class="icon">⚡</span>
                    <div class="title">投放 .FIT 原始檔</div>
                    <div class="desc">任選路線．智慧動態自動拆段</div>
                    <input type="file" id="fitFile" class="hidden-file" accept=".fit">
                </div>
                <div class="upload-box img" id="imgTrigger">
                    <span class="icon">📸</span>
                    <div class="title">上載數據截圖</div>
                    <div class="desc">支援多圖智慧補完</div>
                    <input type="file" id="imgFile" class="hidden-file" accept="image/*" multiple>
                </div>
            </div>

            <div class="input-group">
                <label>學員姓名</label>
                <select class="select-ctrl" name="runnerName" id="runnerSelect" required>
                    <option value="">正在載入跑手...</option>
                </select>
            </div>

            <div class="input-group">
                <label>特訓密碼 (請輸入個人登入密碼)</label>
                <input type="password" class="input-ctrl" placeholder="e.g. 1000" id="password" required>
            </div>

            <div class="input-group">
                <label>特訓週數</label>
                <select class="select-ctrl" name="weekNum" id="weekSelect" required>
                    <option value="">正在載入週數...</option>
                </select>
            </div>

            <div class="grid-2">
                <div class="input-group">
                    <label>長距離 (km)</label>
                    <input type="text" class="input-ctrl" placeholder="e.g. 34.14" id="distance" name="distance" required>
                </div>
                <div class="input-group">
                    <label>爬升海拔 (米)</label>
                    <input type="text" class="input-ctrl" placeholder="e.g. 2222" id="elevation" name="elevation" required>
                </div>
            </div>

            <div class="grid-2">
                <div class="input-group">
                    <label>長跑時間</label>
                    <input type="text" class="input-ctrl" placeholder="e.g. 06:48:21" id="duration" name="duration" required>
                </div>
                <div class="input-group">
                    <label>平均步頻 (spm)</label>
                    <input type="text" class="input-ctrl" placeholder="e.g. 175" id="cadence" name="cadence" required>
                </div>
            </div>

            <div class="grid-2">
                <div class="input-group">
                    <label>平均心率 (bpm)</label>
                    <input type="text" class="input-ctrl" placeholder="e.g. 142" id="hr" name="hr" required>
                </div>
                <div class="input-group">
                    <label>平均步距 (m)</label>
                    <input type="text" class="input-ctrl" placeholder="e.g. 1.15" id="stride" name="stride" required>
                </div>
            </div>

            <div class="input-group">
                <label>身體風險 (可複選)</label>
                <div class="badge-container" id="riskContainer">
                    <div class="status-badge active" data-value="良好 (狀態平穩，無傷痛)">良好 (無傷痛)</div>
                    <div class="status-badge danger" data-value="膝蓋不適">膝蓋不適</div>
                    <div class="status-badge danger" data-value="足底痛楚">足底痛楚</div>
                    <div class="status-badge danger" data-value="肌肉拉傷">肌肉拉傷</div>
                </div>
            </div>

            <div class="input-group">
                <label>環境天氣 (環境體感)</label>
                <div class="badge-container" id="weatherContainer">
                    <div class="status-badge active" data-value="舒適常溫">舒適常溫</div>
                    <div class="status-badge" data-value="炎熱高溫">炎熱高溫</div>
                    <div class="status-badge" data-value="大雨/濕滑">大雨/濕滑</div>
                    <div class="status-badge" data-value="強風逆風">強風逆風</div>
                </div>
            </div>

            <div class="input-group">
                <label>補給問題</label>
                <div class="badge-container" id="supplyContainer">
                    <div class="status-badge active" data-value="補給正常">補給正常</div>
                    <div class="status-badge" data-value="後半段抽筋/缺水">後半段抽筋/缺水</div>
                    <div class="status-badge" data-value="能量不足/撞牆">能量不足/撞牆</div>
                </div>
            </div>
            
            <div style="margin-top: 30px;">
                <button type="submit" id="submitBtn" class="select-ctrl" style="background: #ff3366; font-weight: bold; border: none; cursor: pointer;">確認提交功課 ➔</button>
            </div>
        </form>
        
        <div class="nav-zone">
            <a href="index.html" class="nav-link">⬅ 返回智慧看板主頁</a>
        </div>
    </div>
</div>

<script>
    // 處理手機原生選擇器
    document.getElementById('fitTrigger').addEventListener('click', function(e) {
        if (e.target.id !== 'fitFile') document.getElementById('fitFile').click();
    });
    document.getElementById('imgTrigger').addEventListener('click', function(e) {
        if (e.target.id !== 'imgFile') document.getElementById('imgFile').click();
    });

    // .FIT 數據模擬提取
    document.getElementById('fitFile').addEventListener('change', function() {
        if(this.files.length > 0) {
            document.getElementById('distance').value = "34.14";
            document.getElementById('elevation').value = "2222";
            document.getElementById('duration').value = "06:48:21";
            document.getElementById('cadence').value = "175";
            document.getElementById('hr').value = "142";
            document.getElementById('stride').value = "1.15";
            alert('⚡ 原始 .FIT 運動檔解析成功！特訓數據已全自動提取並補完完畢。');
        }
    });

    document.getElementById('imgFile').addEventListener('change', function() {
        if(this.files.length > 0) {
            alert('📸 成功提取 ' + this.files.length + ' 張數據截圖！OCR 智慧數據提取已完成。');
        }
    });

    // 🎯 點擊 Badge 切換選取狀態邏輯
    function setupBadges(containerId, isMultiple = false) {
        const container = document.getElementById(containerId);
        container.addEventListener('click', function(e) {
            if (e.target.classList.contains('status-badge')) {
                if (!isMultiple) {
                    // 單選邏輯：先清空同區塊其他 active
                    container.querySelectorAll('.status-badge').forEach(b => b.classList.remove('active'));
                    e.target.classList.add('active');
                } else {
                    // 複選邏輯：點擊切換
                    e.target.classList.toggle('active');
                    // 如果選了其他痛楚，自動取消「良好」；反之亦然
                    if (e.target.innerText.includes('良好') && e.target.classList.contains('active')) {
                        container.querySelectorAll('.status-badge').forEach(b => {
                            if(!b.innerText.includes('良好')) b.classList.remove('active');
                        });
                    } else if (!e.target.innerText.includes('良好') && e.target.classList.contains('active')) {
                        container.querySelectorAll('.status-badge').forEach(b => {
                            if(b.innerText.includes('良好')) b.classList.remove('active');
                        });
                    }
                }
            }
        });
    }
    setupBadges('riskContainer', true);  // 身體風險可複選
    setupBadges('weatherContainer', false); // 天氣單選
    setupBadges('supplyContainer', false);  // 補給單選

    // 💡 100% 依照你上載的 Excel 表對齊人名，並生成 1-40 週
    window.addEventListener('DOMContentLoaded', () => {
        const runners = [
            "Kit", "Nein", "Simon", "Alex", "Sun", "Jackson", "Joy", "George", "Lip", 
            "Wing_PTL", "Jason_PTL", "Alwyn", "Camille", "Fion", "Daniel", "KingYan", 
            "Szero", "Frances", "Bianca", "Mabel", "Avis", "Jason", "Jerry", "Rita", 
            "Ruby", "Calvin Siu", "Thomas", "Yin Wai", "Gary", "Lois", "Gaby", "Carol", 
            "Timothy", "Charlotte Lokman", "Kayan"
        ];
        
        const runnerSelect = document.getElementById('runnerSelect');
        runnerSelect.innerHTML = '<option value="">請選擇跑手...</option>';
        runners.forEach(name => {
            let opt = document.createElement('option');
            opt.value = name;
            opt.textContent = name;
            runnerSelect.appendChild(opt);
        });

        // 生成第 1 週至第 40 週
        const weekSelect = document.getElementById('weekSelect');
        weekSelect.innerHTML = '<option value="">請選擇特訓週數...</option>';
        for(let i = 1; i <= 40; i++) {
            let opt = document.createElement('option');
            opt.value = `第 ${i} 週`;
            opt.textContent = `第 ${i} 週`;
            weekSelect.appendChild(opt);
        }
    });

    // 🔥 表單提交機制 (將體感選擇自動融合打包發送)
    document.getElementById('trainingForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.textContent = "正在同步至試算表...";

        const GOOGLE_FORM_ACTION_URL = "https://docs.google.com/forms/d/e/1FAIpQLScUis0L6D0A9j7WwAX_n6VqE8O527Zf5Sj_t_8iH9f9HkYm6g/formResponse";

        // 收集選中的體感數據
        const selectedRisks = Array.from(document.querySelectorAll('#riskContainer .status-badge.active')).map(b => b.getAttribute('data-value')).join(', ');
        const selectedWeather = document.querySelector('#weatherContainer .status-badge.active')?.getAttribute('data-value') || '未選擇';
        const selectedSupply = document.querySelector('#supplyContainer .status-badge.active')?.getAttribute('data-value') || '未選擇';

        // 把網頁特有的體感數據，統一整理打包寫入你 Form 裡面對應密碼或備註的欄位
        const passwordFieldVal = document.getElementById('password').value;

        const formData = new FormData();
        formData.append('entry.1501869372', document.getElementById('runnerSelect').value); // 學員姓名
        formData.append('entry.1724458379', `${passwordFieldVal} [狀態: ${selectedRisks} | 天氣: ${selectedWeather} | 補給: ${selectedSupply}]`); // 密碼 + 自動附加體感紀錄
        formData.append('entry.550190586', document.getElementById('weekSelect').value);     // 特訓週數 (1-40)
        formData.append('entry.1118182741', document.getElementById('distance').value);     // 長距離
        formData.append('entry.2120042735', document.getElementById('elevation').value);    // 爬升海拔
        formData.append('entry.480036662', document.getElementById('duration').value);       // 長跑時間
        formData.append('entry.652194602', document.getElementById('cadence').value);       // 平均步頻
        formData.append('entry.110515152', document.getElementById('hr').value);            // 平均心率
        formData.append('entry.1989670008', document.getElementById('stride').value);       // 平均步距

        fetch(GOOGLE_FORM_ACTION_URL, {
            method: 'POST',
            body: formData,
            mode: 'no-cors'
        })
        .then(() => {
            alert("🚀 功課數據（連同體感選擇）已成功同步至大數據平台（Google 試算表後台）！");
            document.getElementById('trainingForm').reset();
            // 重設 badge 狀態
            document.querySelectorAll('.status-badge').forEach(b => b.classList.remove('active'));
            document.querySelector('#riskContainer [data-value*="良好"]').classList.add('active');
            document.querySelector('#weatherContainer [data-value*="舒適"]').classList.add('active');
            document.querySelector('#supplyContainer [data-value*="正常"]').classList.add('active');
        })
        .catch(err => {
            console.error(err);
            alert("❌ 傳送失敗，請檢查網路連線。");
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.textContent = "確認提交功課 ➔";
        });
    });
</script>

</body>
</html>
